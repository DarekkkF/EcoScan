<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ecoscan_login_gradient"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="690dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="26dp">
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:padding="8dp"
            android:src="@drawable/ecoscan_leaf"
            android:contentDescription="EcoScan" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="EcoScan"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Tu ambiente, siempre bajo control"
            android:textColor="#E0F4E9"
            android:textSize="15sp" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ecoscan_white_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="23dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciar sesión"
                android:textColor="#1D4938"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="22dp"
                android:text="Accede a tu estación ambiental"
                android:textColor="#75857D"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textColor="#66756C"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="21dp"
                android:background="@drawable/ecoscan_input"
                android:drawableStart="@android:drawable/ic_dialog_email"
                android:drawablePadding="12dp"
                android:hint="correo@ejemplo.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="14dp"
                android:textColor="#194833"
                android:textColorHint="#98A69D"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contraseña"
                android:textColor="#66756C"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/ecoscan_input"
                android:hint="Ingresa tu contraseña"
                android:inputType="textPassword"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="14dp"
                android:textColor="#194833"
                android:textColorHint="#98A69D"
                android:textSize="14sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#B6E0CA"
            android:text="Iniciar sesión"
            android:textAllCaps="false"
            android:textColor="#226A4C"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="MONITOREO AMBIENTAL · IOT"
            android:textColor="#D1EBDA"
            android:textSize="11sp"
            android:letterSpacing="0.1" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</ScrollView>
